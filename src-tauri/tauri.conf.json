{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FM27 Manager",
  "version": "0.17.0",
  "identifier": "com.fm27.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FM27 Manager",
        "width": 1500,
        "height": 950,
        "minWidth": 1500,
        "minHeight": 950,
        "maxWidth": 1500,
        "maxHeight": 1300,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDN0REMThFQUVCQUZERDYKUldUVy9icXVqdEY5VERuSUNCMHJiSzA1VG5haUlyQXVWbjRob1Zra0pvMjkrMXcvSmZEN09XUFIK",
      "endpoints": ["https://github.com/Nattends/fm-manager/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
